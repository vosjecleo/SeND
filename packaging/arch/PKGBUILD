pkgname=deltiecord
pkgver=0.9.2
pkgrel=1
pkgdesc='Compact Matrix desktop client'
arch=('x86_64')
url='https://example.invalid/deltiecord'
license=('custom')
depends=('gtk3' 'libsecret' 'libpulse' 'alsa-lib' 'libv4l' 'mpv' 'pipewire' 'xdg-desktop-portal')
makedepends=('flutter' 'cmake' 'clang' 'ninja')
source=()
sha256sums=()

build() {
  cd "$startdir/../.."
  flutter pub get
  flutter build linux --release
}

package() {
  cd "$startdir/../.."
  local bundle='build/linux/x64/release/bundle'
  install -d "$pkgdir/usr/lib/deltiecord" "$pkgdir/usr/bin"
  cp -a "$bundle/." "$pkgdir/usr/lib/deltiecord/"
  install -Dm755 packaging/linux/deltiecord-launcher \
    "$pkgdir/usr/bin/deltiecord"
  install -Dm644 packaging/linux/net.deltie.deltiecord.desktop \
    "$pkgdir/usr/share/applications/net.deltie.deltiecord.desktop"
  install -Dm644 packaging/linux/net.deltie.deltiecord.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/net.deltie.deltiecord.svg"
  install -Dm644 packaging/linux/net.deltie.deltiecord.metainfo.xml \
    "$pkgdir/usr/share/metainfo/net.deltie.deltiecord.appdata.xml"
}
