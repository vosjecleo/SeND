# Flutter WebRTC 1.6.2+hotfix.4 pins libwebrtc m150.7871.03, which logs media
# keys to stderr. Pin the ABI-compatible upstream logging fix without editing
# the developer's pub cache. Both build linking and packaged binaries use it.
if(NOT TARGET flutter_webrtc_plugin)
  message(FATAL_ERROR "SeND RTC runtime requires flutter_webrtc_plugin")
endif()
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  set(_rtc_os linux)
  if(FLUTTER_TARGET_PLATFORM MATCHES "arm64" OR CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
    set(_rtc_arch arm64)
    set(_rtc_sha 5490f26d2ab3bb2108c349162453623ab00c5723fc144e9ca77fcfff78805dc2)
  else()
    set(_rtc_arch x64)
    set(_rtc_sha 39efac2abd9b4ef6c1088f098d8ae8f1e62c7d8726b61344ac73ac8d748ad319)
  endif()
elseif(CMAKE_SYSTEM_NAME STREQUAL "Windows")
  set(_rtc_os win)
  string(TOLOWER "${CMAKE_GENERATOR_PLATFORM}" _rtc_platform)
  if(_rtc_platform STREQUAL "arm64")
    set(_rtc_arch arm64)
    set(_rtc_sha 99b5ba304e077151e47e70f5a92450292563effc38de7538c2b67f610ab74a9d)
  else()
    set(_rtc_arch x64)
    set(_rtc_sha 3bc70034b62cfba19ff24c1a30c7768832990713198038bf9cc56de70c3974cb)
  endif()
else()
  message(FATAL_ERROR "Unsupported SeND desktop RTC target")
endif()
set(_rtc_root "${CMAKE_BINARY_DIR}/send-rtc-runtime")
set(_rtc_archive "${_rtc_root}/libwebrtc-${_rtc_os}-${_rtc_arch}-release.zip")
file(MAKE_DIRECTORY "${_rtc_root}")
if(NOT EXISTS "${_rtc_archive}")
  file(DOWNLOAD
    "https://github.com/webrtc-sdk/libwebrtc/releases/download/libwebrtc.m150.7871.04/libwebrtc-${_rtc_os}-${_rtc_arch}-release.zip"
    "${_rtc_archive}" EXPECTED_HASH "SHA256=${_rtc_sha}" TLS_VERIFY ON
    STATUS _rtc_download TIMEOUT 120)
  list(GET _rtc_download 0 _rtc_status)
  if(NOT _rtc_status EQUAL 0)
    message(FATAL_ERROR "Could not download the pinned SeND RTC runtime")
  endif()
endif()
file(SHA256 "${_rtc_archive}" _rtc_actual_sha)
if(NOT _rtc_actual_sha STREQUAL _rtc_sha)
  message(FATAL_ERROR "SeND RTC runtime checksum mismatch")
endif()
set(_rtc_extract "${_rtc_root}/m150.7871.04")
if(NOT EXISTS "${_rtc_extract}")
  file(MAKE_DIRECTORY "${_rtc_extract}")
  file(ARCHIVE_EXTRACT INPUT "${_rtc_archive}" DESTINATION "${_rtc_extract}")
endif()
if(_rtc_os STREQUAL "linux")
  file(GLOB_RECURSE _rtc_runtime "${_rtc_extract}/libwebrtc.so")
  set(_rtc_link ${_rtc_runtime})
else()
  file(GLOB_RECURSE _rtc_runtime "${_rtc_extract}/libwebrtc.dll")
  file(GLOB_RECURSE _rtc_link "${_rtc_extract}/libwebrtc.dll.lib")
endif()
list(LENGTH _rtc_runtime _rtc_runtime_count)
list(LENGTH _rtc_link _rtc_link_count)
if(NOT _rtc_runtime_count EQUAL 1 OR NOT _rtc_link_count EQUAL 1)
  message(FATAL_ERROR "Unexpected pinned SeND RTC runtime archive layout")
endif()
get_target_property(_rtc_links flutter_webrtc_plugin LINK_LIBRARIES)
set(_rtc_new_links)
set(_rtc_replaced_link FALSE)
foreach(_link IN LISTS _rtc_links)
  if(_link MATCHES "libwebrtc\\.(so|dll\\.lib)$")
    list(APPEND _rtc_new_links ${_rtc_link})
    set(_rtc_replaced_link TRUE)
  else()
    list(APPEND _rtc_new_links "${_link}")
  endif()
endforeach()
if(NOT _rtc_replaced_link)
  message(FATAL_ERROR "Flutter WebRTC link layout changed; review the RTC runtime override")
endif()
set_property(TARGET flutter_webrtc_plugin PROPERTY LINK_LIBRARIES ${_rtc_new_links})
set(_rtc_new_bundle)
set(_rtc_replaced_bundle FALSE)
foreach(_library IN LISTS PLUGIN_BUNDLED_LIBRARIES)
  if(_library MATCHES "libwebrtc\\.(so|dll)$")
    list(APPEND _rtc_new_bundle ${_rtc_runtime})
    set(_rtc_replaced_bundle TRUE)
  else()
    list(APPEND _rtc_new_bundle "${_library}")
  endif()
endforeach()
if(NOT _rtc_replaced_bundle)
  message(FATAL_ERROR "Flutter WebRTC bundle layout changed; review the RTC runtime override")
endif()
set(PLUGIN_BUNDLED_LIBRARIES ${_rtc_new_bundle})
